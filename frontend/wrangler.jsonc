{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecommerce",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "menikstore.my.id", "custom_domain": true },
    { "pattern": "www.menikstore.my.id", "custom_domain": true }
  ],
  "vars": {
    "API_URL": "https://api.menikstore.my.id",
    "SITE_URL": "https://menikstore.my.id"
  },
  "observability": {
    "enabled": true
  }
}
