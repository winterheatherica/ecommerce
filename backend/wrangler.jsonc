{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecommerce-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "UMUM_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "PESANAN_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "workers_dev": false,
  "routes": [
    { "pattern": "api.menikstore.my.id", "custom_domain": true }
  ],
  "vars": {
    "STOREFRONT_URL": "https://menikstore.my.id",
    "API_URL": "https://api.menikstore.my.id",
    "UMUR_PESANAN_JAM": "6",
    "RAJAONGKIR_KURIR": "jne:jnt",
    "COOKIE_DOMAIN": "menikstore.my.id",
    "DOKU_SANDBOX": "false",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFbFY7ynPWwVpk1R",
    "RAJAONGKIR_JATAH_HARIAN": "80",
    "RAJAONGKIR_JATAH_PER_IP": "30",
    "RAJAONGKIR_JATAH_LACAK": "20",
    "MAKS_PESANAN_PER_IP": "10",
    "EMAIL_PENGIRIM": "notifikasi@menikstore.my.id"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
