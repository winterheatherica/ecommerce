{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecommerce-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "UMUM_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "PESANAN_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "workers_dev": false,
  "routes": [
    { "pattern": "api.menikstore.my.id", "custom_domain": true }
  ],
  "vars": {
    "STOREFRONT_URL": "https://menikstore.my.id",
    "UMUR_PESANAN_JAM": "6"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
